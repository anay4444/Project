PORT=3000
HOST=127.0.0.1
TRANSLATION_PROVIDER=libretranslate
TRANSLATION_URL=http://127.0.0.1:5000/translate
TRANSLATION_API_KEY=
# Leave empty for private localhost use. For deployment, set a strong password;
# the browser uses an HttpOnly session cookie after /api/login.
TRANSLATOR_ACCESS_PASSWORD=
KOKORO_TTS_URL=http://127.0.0.1:8880/v1/audio/speech
KOKORO_TTS_BEARER_TOKEN=
KOKORO_TTS_EXTRA_HEADERS={}
